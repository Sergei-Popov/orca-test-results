{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "test-results",
  "name": "Test Results",
  "version": "0.1.0",
  "description": "Review local JUnit test failures and prepare their context for a coding agent.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "test-results",
        "title": "Test Results",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ],
  "author": {
    "name": "Сергей Попов"
  },
  "license": "MIT"
}
